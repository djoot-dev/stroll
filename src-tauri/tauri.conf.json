{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stroll",
  "version": "0.1.2",
  "identifier": "io.github.totalfreak.stroll",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stroll — Guided Code Review",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://avatars.githubusercontent.com data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https://api.github.com https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NUIwQjhDNDNBNjI3NzQKUldSMEo2WkRqQXRiS0RNZjQrN1Zna3gyM0hBa2dyRTNkYXcyY1VFS29OalIvN0Ezai9seEFoRzAK",
      "endpoints": [
        "https://github.com/totalfreak/stroll/releases/latest/download/latest.json"
      ]
    }
  }
}
