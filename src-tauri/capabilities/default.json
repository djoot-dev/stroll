{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Stroll desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "updater:default",
    "process:default",
    "notification:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/**" },
        { "url": "https://github.com/**" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/**" },
        { "url": "https://**" }
      ]
    }
  ]
}
